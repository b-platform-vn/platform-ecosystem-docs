  Project EcomUniversalPlatform_v2 {
    database_type: 'MSSQL'
    Note: 'Mô hình chuẩn hóa _v2 gồm 16 bảng: 8 bảng Auth & Org, 7 bảng Giỏ hàng - Báo giá - Đơn hàng & Thanh toán, 1 bảng AuditLogs.'
  }

  // ============================================================================
  // 1. ĐỊNH DANH & TỔ CHỨC (AUTH & ORGANIZATION - 8 BẢNG)
  // ============================================================================

  // Bảng gốc: tblNguoiLienHe (chỉ lưu thông tin đăng nhập tương tự tblUser)
  Table tblAccount_v2 [headercolor: #1f77b4] {
    Id UUID [pk, note: 'Gốc: tblNguoiLienHe.IDNGUOILIENHE']
    Username nvarchar(50) [unique, null, note: 'Gốc: TenDangNhap']
    Email varchar(250) [unique, null, note: 'Gốc: EMAIL']
    Password nvarchar(255) [not null, note: 'Gốc: MatKhau']
    IsEmailVerified bit [not null, default: 0, note: 'Đã xác thực email - Gốc: IsXacThucEmail']
    IsActive bit [not null, default: 1, note: 'Trạng thái hoạt động - Gốc: ACTIVE']
    IsDeleted bit [not null, default: 0, note: 'Xóa mềm (soft-delete)']
    CreatedBy UUID [null, note: 'Người tạo']
    UpdatedBy UUID [null, note: 'Người cập nhật']
    CreatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NGAYTAO']
    UpdatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NGAYSUA']
  }

  // Bảng mới: Thông tin liên hệ khách hàng cá nhân (B2C), đồng bộ về tblNguoiLienHe
  Table tblCustomer_v2 [headercolor: #1f77b4] {
    Id UUID [pk, note: 'Đồng bộ về tblNguoiLienHe.IDNGUOILIENHE']
    AccountId UUID [null, note: 'FK -> tblAccount_v2.Id']
    Name nvarchar(250) [null, note: 'Họ tên có dấu - Gốc: TenNguoiLienHeUnicode']
    PhoneNumber nvarchar(1000) [null, note: 'Số điện thoại - Gốc: DiDongFull / DIDONG']
    Email varchar(250) [null, note: 'Email liên hệ - Gốc: EMAIL']
    Gender bit [null, note: '1: Nam, 0: Nữ - Gốc: GIOITINH']
    DateOfBirth datetime [null, note: 'Ngày sinh - Gốc: NGAYSINH']
    IsActive bit [not null, default: 1, note: 'Trạng thái hoạt động - Gốc: ACTIVE']
    IsDeleted bit [not null, default: 0, note: 'Xóa mềm (soft-delete)']
    CreatedBy UUID [null, note: 'Người tạo - Gốc: NGUOITAO']
    UpdatedBy UUID [null, note: 'Người cập nhật - Gốc: NGUOISUA']
    CreatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NGAYTAO']
    UpdatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NGAYSUA']
  }

  // Bảng gốc: tblDoiTuong
  Table tblBusiness_v2 [headercolor: #1f77b4] {
    Id UUID [pk, note: 'Gốc: tblDoiTuong.IDDoiTuong']
    BusinessCode nvarchar(50) [unique, not null, note: 'Mã công ty (NOT NULL ở bảng gốc) - Gốc: MaDoiTuong']
    Name nvarchar(255) [not null, note: 'Tên công ty - Gốc: TenDoiTuong / TenDoiTuongUnicode']
    TaxCode nvarchar(50) [unique, null, note: 'Mã số thuế - Gốc: MaSoThue']
    EntityType tinyint [not null, default: 0, note: 'Loại hình (0: DN, 1: Hộ KD) - Gốc: EntityType']
    Address nvarchar(255) [null, note: 'Địa chỉ có dấu - Gốc: DiaChiUnicode']
    Email nvarchar(4000) [null, note: 'Gốc: EmailFull']
    PhoneNumber varchar(255) [null, note: 'Gốc: DienThoaiFull']
    Website varchar(255) [null, note: 'Gốc: WebSite']
    IsActive bit [not null, default: 1, note: 'Gốc: Active']
    IsDeleted bit [not null, default: 0, note: 'Xóa mềm (soft-delete)']
    CreatedBy UUID [null, note: 'Người tạo - Gốc: NGUOITAO']
    UpdatedBy UUID [null, note: 'Người cập nhật - Gốc: NGUOISUA']
    CreatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NGAYTAO']
    UpdatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NGAYSUA']
  }

  // Bảng gốc: tblVaiTro (role.entity.ts)
  Table tblBusinessRole_v2 [headercolor: #1f77b4] {
    Id UUID [pk, note: 'Gốc: tblVaiTro.IDVaiTro']
    BusinessId UUID [null, note: 'NULL = Role mặc định hệ thống - Gốc: IDDoiTuong']
    RoleName nvarchar(255) [not null, note: 'Tên vai trò (User tạo Business sẽ có Role là Creator) - Gốc: TenVaiTroUnicode']
    Description nvarchar(500) [null, note: 'Mô tả vai trò - Gốc: MoTaUnicode']
    IsDefault bit [not null, default: 0, note: 'Gốc: IsMacDinh']
    IsActive bit [not null, default: 1, note: 'Gốc: IsActive']
    IsDeleted bit [not null, default: 0, note: 'Xóa mềm (soft-delete)']
    CreatedBy UUID [null, note: 'Người tạo']
    UpdatedBy UUID [null, note: 'Người cập nhật']
    CreatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NgayTao']
    UpdatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NgayCapNhat']
  }

  // Tách từ cột JSON DanhSachQuyen của tblVaiTro
  Table tblBusinessRolePermission_v2 [headercolor: #1f77b4] {
    Id UUID [pk]
    RoleId UUID [not null, note: 'FK -> tblBusinessRole_v2.Id']
    PermissionKey varchar(100) [not null, note: 'VD: company.profile.update, rfq.quotes.negotiate, order.approval.action']
    CreatedBy UUID [null, note: 'Người tạo']
    UpdatedBy UUID [null, note: 'Người cập nhật']
    CreatedAt datetime [not null, default: `getdate()`]
    UpdatedAt datetime [not null, default: `getdate()`]

    Indexes {
      (RoleId, PermissionKey) [unique]
    }
  }

  // Bảng gốc: tblDoiTuongNguoiLienHe (thông tin cá nhân lưu bên tblCustomer_v2 tránh trùng lặp)
  Table tblBusinessMember_v2 [headercolor: #1f77b4] {
    Id UUID [pk, note: 'Gốc: tblDoiTuongNguoiLienHe.IDDoiTuongNLH']
    BusinessId UUID [not null, note: 'FK -> tblBusiness_v2.Id - Gốc: IDDoiTuong']
    AccountId UUID [not null, note: 'FK -> tblAccount_v2.Id - Gốc: IDNguoiLH']
    IsVerified bit [not null, default: 0, note: '0: Chờ duyệt, 1: Đã duyệt - Gốc: IsXacThuc']
    IsActive bit [not null, default: 1, note: 'Trạng thái hoạt động - Gốc: TrangThai']
    IsDeleted bit [not null, default: 0, note: 'Xóa mềm (soft-delete)']
    CreatedBy UUID [null, note: 'Người tạo']
    UpdatedBy UUID [null, note: 'Người cập nhật']
    CreatedAt datetime [not null, default: `getdate()`, note: 'Gốc: NgayTao']
    UpdatedAt datetime [not null, default: `getdate()`]

    Indexes {
      (BusinessId, AccountId) [unique]
    }
  }

  // Bảng mới: Kết nối n-n giữa BusinessMember và BusinessRole (1 Account có thể có nhiều Role trong cùng 1 Business)
  Table tblBusinessMemberRole_v2 [headercolor: #1f77b4] {
    Id UUID [pk]
    MemberId UUID [not null, note: 'FK -> tblBusinessMember_v2.Id']
    RoleId UUID [not null, note: 'FK -> tblBusinessRole_v2.Id']
    Metadata nvarchar(max) [null, note: 'JSON String (lưu PurchaseLimit - HanMucMua, ...)']
    CreatedBy UUID [null, note: 'Người tạo']
    UpdatedBy UUID [null, note: 'Người cập nhật']
    CreatedAt datetime [not null, default: `getdate()`]
    UpdatedAt datetime [not null, default: `getdate()`]

    Indexes {
      (MemberId, RoleId) [unique]
    }
  }

  // Bảng gốc: tblDiaChiGiaoNhan
  Table tblDeliveryAddress_v2 [headercolor: #1f77b4] {
    Id UUID [pk, note: 'Gốc: tblDiaChiGiaoNhan.IDDiaChiGiaoNhan']
    ObjectType varchar(20) [not null, default: 'Business', note: 'Loại đối tượng sở hữu: Business | Individual']
    ObjectId UUID [not null, note: 'CustomerId (tblCustomer_v2.Id) nếu là Individual, BusinessId (tblBusiness_v2.Id) nếu là Business']
    Label nvarchar(100) [null, note: 'Nhãn địa chỉ (Kho Q1, Văn phòng...) - Gốc: NhanDiaChiUnicode']
    RecipientName nvarchar(255) [not null, note: 'Tên người nhận - Gốc: TenNguoiNhanUnicode']
    RecipientPhone varchar(50) [not null, note: 'SĐT người nhận - Gốc: DienThoaiNguoiNhan']
    Address nvarchar(255) [not null, note: 'Địa chỉ chi tiết - Gốc: DiaChiUnicode']
    IsDefault bit [not null, default: 0, note: 'Gốc: IsMacDinh']
    IsActive bit [not null, default: 1, note: 'Gốc: IsActive']
    IsDeleted bit [not null, default: 0, note: 'Xóa mềm (soft-delete)']
    CreatedBy UUID [null, note: 'Người tạo']
    UpdatedBy UUID [null, note: 'Người cập nhật']
    CreatedAt datetime [not null, default: `getdate()`]
    UpdatedAt datetime [not null, default: `getdate()`]

    Indexes {
      (ObjectType, ObjectId)
    }
  }

  // ============================================================================
// 2. GIỎ HÀNG, BÁO GIÁ, ĐƠN HÀNG & THANH TOÁN (ĐÃ DỌN SẠCH TRƯỜNG DƯ)
// ============================================================================

// 2.1 Cụm giỏ hàng theo phiên
Table tblCart_v2 [headercolor: #2ca02c] {
  Id UUID [pk]
  BrandCode varchar(50) [not null, default: 'MDF', note: 'MDF | ODL']
  ObjectType varchar(20) [not null, default: 'Individual', note: 'Business | Individual']
  ObjectId UUID [null, note: 'CustomerId nếu Individual, BusinessId nếu Business']
  Status varchar(20) [not null, default: 'OPEN', note: 'OPEN | QUOTING | CLOSED']
  SubTotal decimal(18,2) [not null, default: 0, note: 'Tổng tiền gốc']
  TotalDiscount decimal(18,2) [not null, default: 0, note: 'Tổng chiết khấu']
  TotalAmount decimal(18,2) [not null, default: 0, note: 'Tổng tiền thanh toán']
  CreatedBy UUID [null]
  UpdatedBy UUID [null]
  CreatedAt datetime [not null, default: `getdate()`]
  UpdatedAt datetime [not null, default: `getdate()`]

  Indexes {
    (BrandCode, ObjectType, ObjectId)
    Status
  }
}

// 2.2 Đợt giao hàng & Lệnh xuất kho
Table tblCartBatch_v2 [headercolor: #ff7f0e] {
  Id UUID [pk]
  CartId UUID [not null, note: 'FK -> tblCart_v2.Id']
  BatchCode varchar(30) [null, note: 'Mã đợt: DO-202610-001']
  BatchName nvarchar(100) [not null]
  DeliveryAddressId UUID [null, note: 'FK -> tblDeliveryAddress_v2.Id']
  ReceiverName nvarchar(255) [null, note: 'Tên người nhận (override nếu khác sổ địa chỉ)']
  ReceiverPhone varchar(50) [null, note: 'SĐT người nhận (override nếu khác sổ địa chỉ)']
  ExpectedDeliveryDate date [null]
  ShippedAt datetime [null]
  DeliveredAt datetime [null]
  CarrierCode varchar(50) [null]
  TrackingNumber varchar(100) [null]
  ShippingFee decimal(18,2) [not null, default: 0]
  Status varchar(30) [not null, default: 'PLANNED', note: 'PLANNED -> PREPARING -> READY_TO_SHIP -> SHIPPING -> DELIVERED | DELIVERY_FAILED | ON_HOLD | CANCELLED']
  Notes nvarchar(500) [null]
  CreatedBy UUID [null]
  UpdatedBy UUID [null]
  CreatedAt datetime [not null, default: `getdate()`]
  UpdatedAt datetime [not null, default: `getdate()`] 

  Indexes {
    CartId
    Status
  }
}

// 2.3 Chi tiết sản phẩm theo đợt 
Table tblCartItem_v2 [headercolor: #2ca02c] {
  Id UUID [pk]
  CartBatchId UUID [not null, note: 'FK -> tblCartBatch_v2.Id']
  ProductId bigint [not null]
  Quantity decimal(10,2) [not null, default: 1]
  UnitPrice decimal(18,2) [not null, default: 0, note: 'Đơn giá chưa VAT']
  DiscountAmount decimal(18,2) [not null, default: 0, note: 'Giảm giá từng món']
  VatRate decimal(5,2) [not null, default: 0, note: 'Tỷ lệ VAT (%)']
  TotalPrice decimal(18,2) [not null, default: 0, note: '(UnitPrice - Discount) * Quantity * (1 + VatRate/100)']
  CreatedBy UUID [null]
  UpdatedBy UUID [null]
  CreatedAt datetime [not null, default: `getdate()`]
  UpdatedAt datetime [not null, default: `getdate()`]

  Indexes {
    (CartBatchId, ProductId) [unique]
  }
}

// 2.4 Báo giá đàm phán B2B 
Table tblQuote_v2 [headercolor: #17becf] {
  Id UUID [pk]
  QuoteCode nvarchar(30) [unique, not null, note: 'VD: RFQ-202610-001']
  CartId UUID [unique, not null, note: '1-1 với Cart đang đàm phán']
  AssignedTo UUID [null, note: 'Sale phụ trách - FK -> tblAccount_v2.Id']
  Status varchar(30) [not null, default: 'RFQ_REQUESTED', note: 'RFQ_REQUESTED -> PROCESSING -> QUOTED -> ACCEPTED -> REJECTED -> EXPIRED']
  Notes nvarchar(1000) [null, note: 'Thỏa thuận đàm phán riêng']
  ExpiredAt datetime [null, note: 'Hạn chốt báo giá']
  CreatedBy UUID [null]
  UpdatedBy UUID [null]
  CreatedAt datetime [not null, default: `getdate()`]
  UpdatedAt datetime [not null, default: `getdate()`]

  Indexes {
    QuoteCode
    CartId
    AssignedTo
  }
}

// 2.5 Đơn hàng chính thức 
Table tblOrder_v2 [headercolor: #d62728] {
  Id UUID [pk]
  BrandCode varchar(50) [not null, default: 'MDF']
  OrderCode nvarchar(30) [unique, not null]
  CartId UUID [unique, not null, note: '1-1 với Cart đã đóng băng']
  QuoteId UUID [null, note: 'Báo giá nguồn nếu có']
  ObjectType varchar(20) [not null, default: 'Individual']
  ObjectId UUID [not null]
  Status varchar(20) [not null, default: 'CONFIRMED']
  PaymentStatus varchar(20) [not null, default: 'UNPAID']
  DeliveryStatus varchar(20) [not null, default: 'PENDING']
  
  // Thông tin xuất hóa đơn VAT
  IsInvoiceRequested bit [not null, default: 0]
  InvoiceTaxCode varchar(20) [null]
  InvoiceCompanyName nvarchar(255) [null]
  InvoiceAddress nvarchar(500) [null]
  InvoiceEmail varchar(100) [null]

  SubTotal decimal(18,2) [not null, default: 0]
  TotalDiscount decimal(18,2) [not null, default: 0]
  ShippingFee decimal(18,2) [not null, default: 0]
  CodFee decimal(18,2) [not null, default: 0]
  VatAmount decimal(18,2) [not null, default: 0]
  TotalAmount decimal(18,2) [not null, default: 0]
  Notes nvarchar(1000) [null]
  CancelReason nvarchar(255) [null]
  ConfirmedAt datetime [null]
  CompletedAt datetime [null]
  CreatedBy UUID [null]
  UpdatedBy UUID [null]
  CreatedAt datetime [not null, default: `getdate()`]
  UpdatedAt datetime [not null, default: `getdate()`]

  Indexes {
    (BrandCode, Status, PaymentStatus)
    (ObjectType, ObjectId)
  }
}

// 2.6 Phương thức thanh toán
Table tblPaymentMethod_v2 [headercolor: #9467bd] {
  Id UUID [pk]
  MethodCode varchar(50) [unique, not null]
  MethodName nvarchar(100) [not null]
  MethodType varchar(30) [not null, default: 'OFFLINE']
  Provider varchar(50) [null]
  IconUrl nvarchar(500) [null]
  Description nvarchar(500) [null]
  ConfigJson nvarchar(max) [null]
  IsActive bit [not null, default: 1]
  CreatedBy UUID [null]
  UpdatedBy UUID [null]
  CreatedAt datetime [not null, default: `getdate()`]
  UpdatedAt datetime [not null, default: `getdate()`]

  Indexes {
    MethodCode
    IsActive
  }
}

// 2.7 Thanh toán
Table tblPayment_v2 [headercolor: #9467bd] {
  Id UUID [pk]
  OrderId UUID [not null, note: 'FK -> tblOrder_v2.Id']
  PaymentMethodId UUID [not null, note: 'FK -> tblPaymentMethod_v2.Id']
  PaymentCode varchar(50) [unique, not null]
  TransactionCode varchar(100) [null]
  PaymentType varchar(20) [not null, default: 'FULL']
  Amount decimal(18,2) [not null]
  Status varchar(20) [not null, default: 'PENDING']
  DueDate datetime [null]
  PaidAt datetime [null]
  CreatedBy UUID [null]
  CreatedAt datetime [not null, default: `getdate()`]

  Indexes {
    OrderId
    PaymentMethodId
    TransactionCode
  }
}

  // ============================================================================
  // 3. LỊCH SỬ THAY ĐỔI (AUDIT LOGS - 1 BẢNG)
  // ============================================================================

  // Bảng lưu lịch sử mọi thay đổi
  Table tblAuditLogs_v2 [headercolor: #7f7f7f] {
    Id UUID [pk]
    TableName varchar(100) [not null, note: 'Tên bảng bị tác động (VD: tblOrder_v2, tblQuote_v2...)']
    RecordId UUID [not null, note: 'ID bản ghi bị tác động']
    Action varchar(50) [not null, note: 'Hành động: CREATE | UPDATE | DELETE']
    OldValues nvarchar(max) [null, note: 'JSON dữ liệu trước khi sửa']
    NewValues nvarchar(max) [null, note: 'JSON dữ liệu sau khi sửa']
    CreatedBy UUID [null, note: 'Ai thực hiện thay đổi (FK -> tblAccount_v2.Id)']
    CreatedAt datetime [not null, default: `getdate()`, note: 'Thời gian thực hiện']

    Indexes {
      (TableName, RecordId)
      (CreatedBy, CreatedAt)
    }
  }

  // ============================================================================
  // QUAN HỆ KHÓA NGOẠI (FOREIGN KEY RELATIONSHIPS)
  // ============================================================================

  // --- 1. Nhóm Auth & Organization ---
  Ref FK_Customer_Account: tblCustomer_v2.AccountId > tblAccount_v2.Id
  Ref FK_BusinessRole_Business: tblBusinessRole_v2.BusinessId > tblBusiness_v2.Id
  Ref FK_RolePermission_Role: tblBusinessRolePermission_v2.RoleId > tblBusinessRole_v2.Id [delete: cascade]
  Ref FK_BusinessMember_Business: tblBusinessMember_v2.BusinessId > tblBusiness_v2.Id [delete: cascade]
  Ref FK_BusinessMember_Account: tblBusinessMember_v2.AccountId > tblAccount_v2.Id [delete: cascade]
  Ref FK_MemberRole_Member: tblBusinessMemberRole_v2.MemberId > tblBusinessMember_v2.Id [delete: cascade]
  Ref FK_MemberRole_Role: tblBusinessMemberRole_v2.RoleId > tblBusinessRole_v2.Id [delete: cascade]

  // Sổ địa chỉ kết nối đa hình về Customer / Business
  Ref FK_DeliveryAddress_Customer: tblDeliveryAddress_v2.ObjectId > tblCustomer_v2.Id
  Ref FK_DeliveryAddress_Business: tblDeliveryAddress_v2.ObjectId > tblBusiness_v2.Id

  // --- 2. Nhóm Giỏ hàng & Đợt giao hàng ---
  Ref: tblCartBatch_v2.CartId > tblCart_v2.Id [delete: restrict]
  Ref: tblCartItem_v2.CartBatchId > tblCartBatch_v2.Id [delete: restrict]
  Ref: tblCartBatch_v2.DeliveryAddressId > tblDeliveryAddress_v2.Id

  // Giỏ hàng kết nối đa hình về Customer / Business
  Ref: tblCart_v2.ObjectId > tblCustomer_v2.Id
  Ref: tblCart_v2.ObjectId > tblBusiness_v2.Id

  // --- 3. Nhóm Báo giá RFQ ---
  Ref: tblQuote_v2.CartId > tblCart_v2.Id [delete: restrict]
  Ref: tblQuote_v2.AssignedTo > tblAccount_v2.Id

  // --- 4. Nhóm Đơn hàng & Thanh toán ---
  Ref: tblOrder_v2.CartId - tblCart_v2.Id [delete: restrict]
  Ref: tblOrder_v2.QuoteId > tblQuote_v2.Id [delete: restrict]
  Ref: tblOrder_v2.ObjectId > tblCustomer_v2.Id
  Ref: tblOrder_v2.ObjectId > tblBusiness_v2.Id

  Ref: tblPayment_v2.OrderId > tblOrder_v2.Id [delete: restrict]
  Ref: tblPayment_v2.PaymentMethodId > tblPaymentMethod_v2.Id [delete: restrict]

  // --- 5. Nhóm Audit Logs ---
  Ref FK_AuditLogs_Actor: tblAuditLogs_v2.CreatedBy > tblAccount_v2.Id